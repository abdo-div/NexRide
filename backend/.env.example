# Copy to .env for local configuration. Never commit real credentials.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Required authentication key: use a private random value of at least 32 bytes.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes-long
# JWT_EXPIRES_IN=90d
# JWT_COOKIE_EXPIRES_IN=90

# MongoDB: use a replica-set-enabled database for transaction-backed workflows.
# If unset, the backend uses mongodb://127.0.0.1:27017/nexride?replicaSet=rs0.
# Set one URI variable; MONGODB_URI is preferred.
# MONGODB_URI=
# MONGO_URI=
# DATABASE_URI=
# DATABASE_URL=
# DATABASE=

# Redis: used for cache, idempotency, reservation coordination and email queues.
# If unset, the backend uses 127.0.0.1:6379.
# Use REDIS_URL for a URI-based deployment, or configure host settings.
# REDIS_URL=
# Other URL aliases read by the code (REDIS_URL is recommended).
# UPSTASH_REDIS_URL=
# REDIS_CONNECTION_STRING=
# UPSTASH_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_PROBE_TIMEOUT_MS=1500

# Optional. Override Node DNS resolution when the host resolver cannot resolve
# MongoDB Atlas/SRV records. Comma-separated IP addresses; omit to use system DNS.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Frontend origins and links
# Comma-separated exact CORS origins (development defaults include both Vite ports).
# FRONTEND_DOMAIN=http://localhost:5173,http://localhost:5174
# FRONTEND_URL=http://localhost:5173
# CLIENT_URL=http://localhost:5173

# Development SMTP defaults to 127.0.0.1:1025.
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# EMAIL_FROM_NAME=NexRide Support

# Optional production SMTP configuration
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional Moamalat integration. Credentials are required to initiate payments.
# MOAMALAT_ENV=test
# MOAMALAT_MID=
# MOAMALAT_TID=
# MOAMALAT_SECURE_KEY=

# Optional Stripe integration
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional observability
# SENTRY_DSN is referenced by the Sentry config module; startup does not
# currently initialize Sentry.
# SENTRY_DSN=
