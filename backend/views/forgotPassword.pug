extends base

block content
  style.
    body { overflow-x: hidden; }
    .glass-card { background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid rgba(128,131,255,0.1); box-shadow: 0 0 40px rgba(0,0,0,0.3), inset 0 0 20px rgba(128,131,255,0.05); }
    .neon-rim::after { content: ''; position: absolute; inset: -1px; background: linear-gradient(135deg, #c0c1ff 0%, #2fd9f4 100%); z-index: -1; border-radius: inherit; opacity: 0.15; }
    .glow-button { transition: all 0.3s ease; }
    .glow-button:hover { box-shadow: 0 0 20px rgba(192,193,255,0.3); transform: translateY(-1px); }
    .step-transition { transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
    .hidden-step { opacity: 0; transform: translateY(20px); pointer-events: none; position: absolute; }
    input:focus { outline: none; border-bottom-color: var(--color-secondary) !important; box-shadow: none !important; }

  //- Top bar
  header(class="w-full px-gutter py-md z-50 flex justify-center lg:justify-start")
    .font-display-lg.text-headline-md.font-extrabold.tracking-tighter.text-primary-fixed-dim.flex.items-center.gap-2
      span.material-symbols-outlined.text-secondary(style="font-variation-settings: 'FILL' 1;") bolt
      a(href='/') NexRide

  main.flex-grow.flex.items-center.justify-center.px-gutter.py-xl.relative.min-h-screen
    .w-full.max-w-md.relative
      div(class="glass-card neon-rim rounded-xl p-lg md:p-xl flex flex-col gap-md")#auth-card

        //- Step 1: Email Input
        .step-transition.flex.flex-col.gap-md#step-1
          div(class="text-center md:text-left")
            h1.font-headline-lg.text-headline-lg.text-on-surface.mb-xs Reset Your Password
            p.font-body-md.text-body-md.text-on-surface-variant Enter your email address and we'll send you a secure link to reset your credentials.
          form.flex.flex-col.gap-md#reset-form(onsubmit='handleReset(event)')
            .flex.flex-col.gap-xs
              label.font-label-md.text-label-md.text-on-surface-variant(for='reset-email') Email Address
              .relative
                input#reset-email.w-full.bg-surface-container-lowest.border-0.border-b-2.border-outline-variant.py-4.px-0.font-body-md.text-body-md.text-on-surface(class="placeholder:text-outline" type='email' placeholder='name@company.com' required)
                span.material-symbols-outlined.absolute.right-0.text-outline-variant(class="top-1/2 -translate-y-1/2") mail
            button.glow-button.bg-primary.text-on-primary.font-label-md.text-label-md.py-4.rounded-lg.flex.items-center.justify-center.gap-2.transition-all(class="active:scale-95" type='submit')
              | Send Reset Link
              span.material-symbols-outlined(class="text-[18px]") arrow_forward
          .flex.flex-col.items-center.gap-sm.mt-sm
            a.font-label-md.text-label-md.text-secondary.flex.items-center.gap-2(class="hover:text-primary transition-colors" href='/login')
              span.material-symbols-outlined(class="text-[16px]") arrow_back
              | Back to Sign In

        //- Step 2: Success
        .step-transition.hidden-step.flex.flex-col.items-center.text-center.gap-md#step-2
          div(class="w-20 h-20 rounded-full bg-tertiary/10 flex items-center justify-center mb-xs")
            span.material-symbols-outlined.text-tertiary(class="text-[48px]" style="font-variation-settings: 'FILL' 1;") check_circle
          div
            h2.font-headline-lg.text-headline-lg.text-on-surface.mb-xs Check your inbox!
            p.font-body-md.text-body-md.text-on-surface-variant
              | We've sent a password reset link to 
              span.text-secondary.font-semibold#display-email your email
              | . Please follow the instructions to secure your account.
          div(class="w-full h-px bg-outline-variant/30 my-xs")
          .flex.flex-col.gap-md.w-full
            p.font-label-sm.text-label-sm.text-outline Didn't receive an email? Check your spam folder or
            button.w-full.bg-surface-variant.text-on-surface.font-label-md.text-label-md.py-3.rounded-lg.transition-colors(class="hover:bg-outline-variant active:scale-95" onclick='handleResend()') Resend Link
            a.font-label-md.text-label-md.text-primary(class="hover:underline transition-all" href='/login') Return to Login

  footer(class="w-full py-lg border-t border-outline-variant/10 relative z-10")
    div(class="max-w-container-max mx-auto px-gutter flex flex-col md:flex-row justify-between items-center gap-md")
      div(class="font-body-md text-body-md text-on-surface-variant/60") © 2025 NexRide Premium. All rights reserved.
      .flex.gap-md
        a.font-label-sm.text-label-sm.text-on-surface-variant(class="hover:text-secondary transition-colors" href='#') Privacy Policy
        a.font-label-sm.text-label-sm.text-on-surface-variant(class="hover:text-secondary transition-colors" href='#') Terms of Service

block scripts
  script.
    async function handleReset(event) {
      event.preventDefault();
      const email = document.getElementById('reset-email').value;
      try {
        const res = await fetch('/api/v1/users/forgotPassword', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();
        document.getElementById('display-email').textContent = email;
        const step1 = document.getElementById('step-1');
        const step2 = document.getElementById('step-2');
        step1.classList.add('hidden-step');
        setTimeout(() => {
          step1.style.display = 'none';
          step2.style.position = 'relative';
          step2.classList.remove('hidden-step');
        }, 400);
      } catch(e) { alert('Something went wrong. Please try again.'); }
    }

    function handleResend() {
      const btn = event.currentTarget;
      const orig = btn.textContent;
      btn.textContent = 'Sent! ✓';
      btn.classList.add('text-tertiary');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('text-tertiary'); }, 2000);
    }
