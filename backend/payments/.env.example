MPGS_BASE_URL=https://your-assigned-gateway-host
MPGS_MERCHANT_ID=TEST_YOUR_MERCHANT
MPGS_API_PASSWORD=replace-with-test-api-password
MPGS_API_VERSION=100
MPGS_CURRENCY=LYD
MPGS_OPERATION=PURCHASE
MPGS_MERCHANT_NAME=Your Company Name

# NexRide-only local simulator flag. The portable real MPGS provider does not
# read this value. Simulation is always disabled when NODE_ENV=production.
MPGS_SIMULATOR=true
