# Production template only. Copy values into the VPS secret/environment
# manager; do not commit the resulting .env file. Every replace-* value must be
# changed before `npm run validate:production-env` can pass.

NODE_ENV=production
PORT=3000
BIND_HOST=127.0.0.1
LOG_LEVEL=info

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30

FRONTEND_URL=https://replace-with-public-domain.example
FRONTEND_DOMAIN=https://replace-with-public-domain.example
# FRONTEND_DIST_DIR=/srv/nexride/frontend/dist

# A replica set is required for transaction-backed bookings.
MONGODB_URI=mongodb://nexride_app:replace-with-password@127.0.0.1:27017/nexride?replicaSet=rs0&authSource=admin&retryWrites=true&w=majority

REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=nexride
REDIS_PASSWORD=replace-with-redis-password
# For a managed service, replace the four REDIS_HOST/PORT/USERNAME/PASSWORD
# values above with one TLS URL containing a named ACL user:
# REDIS_URL=rediss://nexride:replace-with-password@redis-host.example:6379
REDIS_PROBE_TIMEOUT_MS=1500
EMAIL_QUEUE_ENABLED=false

PRIVATE_STORAGE_DIR=/var/lib/nexride/private

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=support@replace-with-public-domain.example
EMAIL_FROM_NAME=NexRide Support

# Configure both or omit both to disable Google sign-in.
# GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

MOAMALAT_ENV=production
MOAMALAT_TIME_ZONE=Africa/Tripoli
MOAMALAT_MID=replace-with-live-merchant-id
MOAMALAT_TID=replace-with-live-terminal-id
MOAMALAT_SECURE_KEY=replace-with-live-hex-signing-key

# Optional DNS override; normally leave unset.
# DNS_SERVERS=1.1.1.1,8.8.8.8
