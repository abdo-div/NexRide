# Copy to /etc/nexride/monitor.env, mode 0640, owned by root:nexride-monitor.
PUBLIC_HOST=your-domain.example
ALERT_WEBHOOK_URL=https://alerts.example/hooks/replace-with-secret

API_BASE_URL=http://127.0.0.1:3000
MONITORED_SERVICES="nginx nexride mongod redis-server"
BACKUP_SERVICES="nexride-mongodb-backup.service nexride-files-backup.service"
DISK_PATHS="/ /var/lib/nexride /var/backups/nexride"
DISK_WARN_PERCENT=85
TLS_WARN_DAYS=14
BACKUP_MAX_AGE_SECONDS=108000
ALERT_REPEAT_SECONDS=3600

