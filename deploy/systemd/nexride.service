[Unit]
Description=NexRide production API
Documentation=file:///srv/nexride/docs/VPS_NODE_SERVICE.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nexride
Group=nexride
WorkingDirectory=/srv/nexride/backend
EnvironmentFile=/etc/nexride/backend.env

# Refuse to start with missing, placeholder, or unsafe production settings.
ExecStartPre=/usr/bin/node scripts/validateProductionEnv.js
ExecStart=/usr/bin/node server.js

# A single process is intentional: the API also owns scheduled booking expiry
# and the email worker. Multiple instances would duplicate those consumers.
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=30
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexride
LimitNOFILE=65535
UMask=0027

# The service only needs write access to persistent generated media, private
# uploaded documents, and its isolated temporary directory. Application source
# and the rest of the host remain read-only from this process.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexride/public /var/lib/nexride/private

[Install]
WantedBy=multi-user.target
