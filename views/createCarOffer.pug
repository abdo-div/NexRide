extends base

block head
  style.
    .neon-border-focus:focus-within {
      border-color: var(--color-primary);
      box-shadow: 0 0 15px color-mix(in srgb, var(--color-primary) 15%, transparent);
    }
    .step-active {
      color: var(--color-primary);
      text-shadow: 0 0 8px color-mix(in srgb, var(--color-primary) 50%, transparent);
    }

