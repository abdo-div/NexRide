            span.material-symbols-outlined bolt
            | Publish Listing

block scripts
  script.
    let accumulatedGallery = [];

    function renderAllPreviews() {
      const grid = document.getElementById("previewGrid");
      const placeholder = document.getElementById("uploadPlaceholder");
      const coverInput = document.getElementById("imageCover");
      if (!grid || !placeholder) return;
      grid.innerHTML = "";
      const allFiles = [];
      if (coverInput && coverInput.files && coverInput.files[0]) {
        allFiles.push({ file: coverInput.files[0], isCover: true });
      }
      for (const f of accumulatedGallery) {
        allFiles.push({ file: f, isCover: false });
      }
      if (allFiles.length === 0) {
        grid.classList.add("hidden");
        placeholder.classList.remove("hidden");
        return;
      }
      placeholder.classList.add("hidden");
      grid.classList.remove("hidden");
      for (const entry of allFiles) {
        const reader = new FileReader();
        reader.onload = function (e) {
          const div = document.createElement("div");
          div.className = "relative rounded-xl overflow-hidden group w-28 shrink-0";
          div.innerHTML =
            '<img src="' + e.target.result + '" class="w-full h-24 object-cover rounded-xl"/>' +
            '<div class="absolute inset-0 rounded-xl ring-1 ring-inset ' + (entry.isCover ? "ring-primary ring-2" : "ring-white/10") + '"></div>' +
            (entry.isCover ? '<span class="absolute top-2 left-2 bg-primary text-on-primary text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">Cover</span>' : "");
          grid.appendChild(div);
        };
        reader.readAsDataURL(entry.file);
      }
    }

    document.addEventListener("DOMContentLoaded", function () {
      document.querySelectorAll("input, select, textarea").forEach(function (el) {
        el.addEventListener("focus", function () {
          var parent = el.closest(".flex");
          if (parent) parent.classList.add("neon-border-focus");
        });
        el.addEventListener("blur", function () {
          var parent = el.closest(".flex");
          if (parent) parent.classList.remove("neon-border-focus");
        });
      });

      var coverInput = document.getElementById("imageCover");
      if (coverInput) coverInput.addEventListener("change", renderAllPreviews);

      var galleryInput = document.getElementById("images");
      if (galleryInput) {
        galleryInput.addEventListener("change", function () {
          for (var i = 0; i < this.files.length; i++) {
            var f = this.files[i];
            var dup = false;
            for (var j = 0; j < accumulatedGallery.length; j++) {
              var x = accumulatedGallery[j];
              if (x.name === f.name && x.size === f.size && x.lastModified === f.lastModified) {
                dup = true;
                break;
              }
            }
            if (!dup) accumulatedGallery.push(f);
          }
          renderAllPreviews();
        });
      }

      var cancelBtn = document.getElementById("cancelBtn");
      if (cancelBtn) {
        cancelBtn.addEventListener("click", function () {
          var form = document.querySelector("form");
          if (form) form.reset();
          accumulatedGallery = [];
          renderAllPreviews();
        });
      }

      var form = document.querySelector("form");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var fd = new FormData(this);
          fd.delete("images");
          for (var i = 0; i < accumulatedGallery.length; i++) {
            fd.append("images", accumulatedGallery[i]);
          }
          fetch(this.action, { method: "POST", body: fd }).then(function (res) {
            if (res.redirected) window.location.href = res.url;
            else window.location.href = "/fleet";
          }).catch(function () {
            alert("Upload failed. Please try again.");
          });
        });
      }
    });
