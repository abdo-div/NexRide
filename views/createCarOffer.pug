              span.font-body-md.text-body-md.text-on-surface-variant(class="group-hover:text-on-surface transition-colors") Panoramic Roof
            label.flex.items-center.gap-sm.cursor-pointer.group
              input.w-5.h-5.rounded.border-outline-variant.bg-surface.text-primary(type="checkbox" class="focus:ring-primary/50" name="features" value="Heated Seats")
              span.font-body-md.text-body-md.text-on-surface-variant(class="group-hover:text-on-surface transition-colors") Heated Seats
